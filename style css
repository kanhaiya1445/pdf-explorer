
*{box-sizing:border-box} :root{--bg:#f6f7fb;--white:#fff;--ink:#11131a;--muted:#6d7482;--line:#e3e6ee;--accent:#5a49ff;--good:#14885a;--shadow:0 18px 55px #1a1d2b12}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif}header{height:72px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 max(18px,calc((100vw - 1180px)/2))}header span{font-size:13px;color:var(--muted)}.brand{display:flex;align-items:center;gap:10px;font-size:20px}.brand b{display:grid;place-items:center;width:34px;height:34px;background:var(--accent);color:white;border-radius:10px}.hero,main{max-width:1180px;margin:auto}.hero{padding:55px 24px 35px;display:flex;justify-content:space-between;align-items:end;gap:35px}.hero small,.result small{letter-spacing:.15em;font-weight:800;color:var(--accent);font-size:10px}.hero h1{font-size:clamp(42px,6vw,70px);line-height:.98;letter-spacing:-.055em;margin:12px 0}.hero em{font-style:normal;color:var(--accent)}.hero p{max-width:650px;color:var(--muted);font-size:17px;line-height:1.6}.flow{background:#11131a;color:#fff;padding:18px 20px;border-radius:16px;font-size:12px;white-space:nowrap}.flow i{color:#999;margin:0 10px}.grid{padding:0 24px;display:grid;grid-template-columns:1fr 1fr;gap:18px}.grid article,.card,.trust div{background:#fff;border:1px solid var(--line);border-radius:22px;padding:27px;box-shadow:var(--shadow)}.head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.head h2{font-size:18px;margin:0}.head h2 small{color:var(--accent);margin-right:10px}.head span{font-size:10px;color:var(--muted);letter-spacing:.08em}.head button{border:0;background:none;color:var(--muted);cursor:pointer}.drop{min-height:300px;border:1.5px dashed #cbd0db;border-radius:17px;display:grid;place-items:center;text-align:center;padding:28px;cursor:pointer}.drop:hover{border-color:var(--accent);background:#fbfaff}.drop input{display:none}.icon{width:58px;height:58px;background:#f0eeff;color:var(--accent);border-radius:16px;display:grid;place-items:center;font-size:24px;font-weight:800}.drop h3{margin:10px 0 4px}.drop p{margin:0;color:var(--muted)}.drop>small{margin-top:16px;color:#9299a7}.info{margin-top:12px;padding:12px;border-radius:11px;background:#f5f6fa;font-size:13px}.hide{display:none!important}.tabs{display:flex;background:#f1f2f6;padding:4px;border-radius:11px;margin-bottom:18px}.tabs button{flex:1;border:0;background:none;padding:9px;border-radius:8px;font-weight:700;color:var(--muted);cursor:pointer}.tabs button.active{background:#fff;color:#111;box-shadow:0 2px 9px #0000000d}.form{display:grid;grid-template-columns:1fr 1fr;gap:14px}.form label{font-size:12px;font-weight:700;color:#565d6a}.form input,.form select{width:100%;margin-top:7px;border:1px solid var(--line);border-radius:10px;padding:12px;background:#fff;font:inherit}.form label>div{position:relative}.form label>div span{position:absolute;right:12px;top:18px;color:#888}.form input{padding-right:42px}.tip,.note{font-size:12px;color:var(--muted);line-height:1.5}.primary{width:100%;border:0;border-radius:12px;padding:14px 16px;background:var(--accent);color:#fff;font-weight:800;display:flex;justify-content:space-between;text-decoration:none;cursor:pointer}.primary:disabled{opacity:.45;cursor:not-allowed}.card{margin:18px 24px}.progress-title,.resulthead{display:flex;justify-content:space-between;align-items:center}.bar{height:8px;background:#edf0f5;border-radius:10px;margin:17px 0;overflow:hidden}.bar i{display:block;height:100%;width:0;background:var(--accent);transition:.25s}.card>small{color:var(--muted)}.resulthead>div{display:flex;gap:12px;align-items:center}.ok{width:38px;height:38px;border-radius:50%;background:#e6f7ef;color:var(--good);display:grid;place-items:center}.resulthead h2{margin:4px 0}.resulthead mark{background:#e6f7ef;color:var(--good);padding:7px 10px;border-radius:20px;font-size:10px;font-weight:900}.stats{display:grid;grid-template-columns:repeat(4,1fr);margin:24px 0;border:1px solid var(--line);border-radius:13px;overflow:hidden}.stats div{padding:16px;border-right:1px solid var(--line);font-size:11px;color:var(--muted)}.stats div:last-child{border:0}.stats strong{display:block;color:var(--ink);font-size:17px;margin-top:6px}.trust{padding:0 24px 50px;display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-top:18px}.trust div{padding:17px}.trust b{display:block;font-size:13px;margin-bottom:5px}.trust span{font-size:12px;color:var(--muted)}footer{text-align:center;border-top:1px solid var(--line);padding:24px;color:#888;font-size:12px}@media(max-width:850px){.hero{display:block}.flow{margin-top:22px;white-space:normal}.grid{grid-template-columns:1fr}.trust{grid-template-columns:1fr}}@media(max-width:520px){header span{display:none}.hero{padding-top:35px}.grid,.trust{padding-left:14px;padding-right:14px}.card{margin-left:14px;margin-right:14px}.grid article,.card{padding:19px}.form,.stats{grid-template-columns:1fr 1fr}.stats div:nth-child(2){border-right:0}.stats div{border-bottom:1px solid var(--line)}.form{grid-template-columns:1fr}}
.size-input{display:grid;grid-template-columns:1fr 92px;gap:7px}.size-input select{margin-top:7px}.size-input input{margin-top:7px!important}
